# Copy this file to `.env` and fill in your own keys.
# All variables must keep the VITE_ prefix to be exposed to the client bundle.

# NewsAPI.org — register for a free developer key at https://newsapi.org/register
# Note: the free NewsAPI tier blocks browser (CORS) requests outside localhost.
VITE_NEWS_API_KEY=

# The Guardian Content API — request a key at https://open-platform.theguardian.com/access/
VITE_GUARDIAN_API_KEY=

# New York Times Article Search API — create an app at https://developer.nytimes.com/my-apps
# and enable "Article Search API". Only the api-key is needed for requests.
VITE_NYT_API_KEY=

# Reserved: the NYT developer portal also issues a secret for OAuth-style flows.
# Article Search does not use it, but it is kept here for completeness.
VITE_NYT_API_SECRET=
