{
    "plugins": [
        "@trivago/prettier-plugin-sort-imports",
        "prettier-plugin-tailwindcss"
    ],
    "semi": false,
    "tabWidth": 2,
    "useTabs": false,
    "printWidth": 80,
    "endOfLine": "lf",
    "singleQuote": true,
    "arrowParens": "always",
    "importOrder": [
        "^react",
        "<THIRD_PARTY_MODULES>",
        "^./pages",
        "^./components",
        "^./layouts",
        "^./providers",
        "^./utils",
        "^./types",
        "^./hooks",
        "^./services",
        "^[./]"
    ],
    "importOrderSeparation": true,
    "tailwindFunctions": [
        "cn"
    ]
}